[{"id":"finis","term":"目的","latin":"finis","def":"我们为了它而行动的那个东西：在实现上最后达到，在意向中却最先出现。","ref":"神学大全 I-II, q.1","lesson":"T1-01"},{"id":"finis-ultimus","term":"最终目的","latin":"finis ultimus","def":"不再为了其他目的而追求的目的；人的最终目的是天主本身。","ref":"《天主教教理》27","lesson":"T1-06"},{"id":"intentio","term":"意向","latin":"intentio","def":"意志朝向目的的动向；它可以使个别行为，甚至整个生命，指向最终目的。","ref":"《天主教教理》1752","lesson":"T1-01"},{"id":"actus-humanus","term":"人性行为","latin":"actus humanus","def":"出于人经过考虑的自由意志的行为；只有这样的行为才有伦理上的善恶。","ref":"《天主教教理》1749","lesson":"T1-01"},{"id":"bonum-apparens","term":"表面的善","latin":"bonum apparens","def":"看似对人有益、其实不能成全人的东西；罪人就是被这样的善欺骗，在错误的地方寻找幸福。","ref":"神学大全 I-II, q.8, a.1","lesson":"T1-06"},{"id":"felicitas","term":"幸福","latin":"felicitas","def":"人心安享所渴望之善的状态。人必然渴望幸福，自由选择的是在哪里寻找它。","ref":"《天主教教理》1718","lesson":"T1-06"},{"id":"beatitudo","term":"真福","latin":"beatitudo","def":"人圆满的幸福，只在于拥有天主；它超越人的能力，是天主白白的恩赐。","ref":"《天主教教理》1722","lesson":"T1-06"},{"id":"supernaturalis","term":"本性的／超性的","aliases":["超性的","超性"],"latin":"naturalis / supernaturalis","def":"本性的，指人凭自己本性的力量所能达到的；超性的，指超越人的一切能力、只能藉天主恩宠达到的。","ref":"《天主教教理》1722","lesson":"T1-06"},{"id":"beatitudo-obiectiva","term":"客观幸福／主观幸福","latin":"beatitudo obiectiva / formalis","def":"客观的幸福是使人幸福的对象本身，即天主；主观的幸福是人拥有并享受这对象的状态。","ref":"神学大全 I-II, q.3, a.1","lesson":"T1-06"},{"id":"visio-beatifica","term":"荣福直观","latin":"visio beatifica","def":"在天上面对面直接看见天主；这是人圆满的真福。","ref":"《天主教教理》1028","lesson":"T1-11"},{"id":"vita-aeterna","term":"永生","latin":"vita aeterna","def":"分享天主自己的生命；在死后才圆满达到，但藉信德今天已经开始。","ref":"《真理的光辉》12","lesson":"T1-12"},{"id":"praecepta","term":"诫命","latin":"praecepta","def":"天主指示人生命道路的命令；它们保护人的善，是爱近人的基本条件，也是走向自由的第一步。","ref":"《真理的光辉》12–13","lesson":"T1-12"},{"id":"sequela-christi","term":"跟随基督","latin":"sequela Christi","def":"基督徒伦理生活的核心：不只是遵守规则，而是亲自追随耶稣，与祂结合。","ref":"《真理的光辉》19","lesson":"T1-12"},{"id":"principium","term":"原则与基础","latin":"Principium et Fundamentum","def":"圣依纳爵《神操》的开端：人受造是为赞美、尊敬和事奉天主，并借此救自己的灵魂；其他事物都应以能否帮助人达到这目的为准来使用。","ref":"《神操》23","lesson":"T1-12"},{"id":"bonum-commune","term":"公益","latin":"bonum commune","def":"使团体及其成员更容易达到自身成全的社会条件的总和。","ref":"《天主教教理》1906","lesson":"T1-05"},{"id":"religiosus","term":"宗教性的存有","latin":"homo religiosus","def":"人在历史中以祈祷、祭献、敬礼、默想等方式表达对天主的寻求；这些表达方式虽然有些是模糊的，却如此普遍，以致人可以被称为宗教性的存有。","ref":"《天主教教理》28","lesson":"FT-T1-01"},{"id":"desiderium-dei","term":"对天主的渴望","latin":"desiderium Dei","def":"对天主的渴求已铭刻在人的心中，因为人是由天主及为天主而受造；只有在天主内，人才能找到他不断寻找的真理和幸福。","ref":"《天主教教理》27","lesson":"FT-T1-01","aliases":["对天主的渴求"]},{"id":"cor-inquietum","term":"不安的心","latin":"cor inquietum","def":"圣奥思定的名言：人是为了天主而受造，除非安息在天主内，人的心得不到安宁。","ref":"《天主教教理》30","lesson":"FT-T1-02"},{"id":"lumen-naturale","term":"理智的自然之光","latin":"lumen naturale rationis","def":"人的理智本身的认识能力。教会教导：人凭理智的自然之光，能透过受造物确实认识天主──万物的起源和终结。","ref":"《天主教教理》36；《天主之子》2","lesson":"FT-T1-03","aliases":["自然之光"]},{"id":"viae","term":"认识天主的途径","latin":"viae","def":"从物质世界和人出发、“会集在一起而又令人信服”的论据，能使人确实认识天主存在；它们不是自然科学所寻求的那种证明。","ref":"《天主教教理》31–34","lesson":"FT-T1-03","aliases":["天主存在的证据","天主存在的证据"]},{"id":"contingentia","term":"非必然性","latin":"contingentia","def":"事物存在，却不是必然存在；它的存在有赖于别的原因。这是从世界出发认识天主的起点之一。","ref":"《天主教教理》32","lesson":"FT-T1-03"},{"id":"necessitas-moralis","term":"启示在伦理上的必要性","latin":"necessitas moralis revelationis","def":"即使是本来并非不可理解的宗教和伦理真理，人也需要天主启示的光照，使众人能毫无困难地、以坚定的确实性并绝无错误地认识它们。","ref":"《天主教教理》38","lesson":"FT-T1-04"},{"id":"mysterium","term":"奥迹","latin":"mysterium","def":"超越人的理智、唯有天主启示才能认识的真理，例如天主是父、子、圣神。","ref":"《天主教教理》50；237","lesson":"FT-T1-04","aliases":["奥迹","超性真理"]},{"id":"analogia","term":"类比","latin":"analogia","def":"以取自受造物的言语真实地谈论天主，同时记得：“每当我们在造物主与受造物之间察觉到若干相同之处时，就必发现两者间有更大的不同之处”。","ref":"《天主教教理》40–43","lesson":"FT-T1-04"},{"id":"malum-morale","term":"伦理的恶","latin":"malum morale","def":"理性和自由的受造物以自由抉择所犯的罪；其严重性与物质的恶不能相比。天主无论直接或间接，都绝不是伦理恶的原因。","ref":"《天主教教理》311","lesson":"FT-T1-05","aliases":["伦理恶"]},{"id":"malum-physicum","term":"物质的恶","latin":"malum physicum","def":"在一个“在过程中”、迈向最终完美的世界里，自然界的败坏、疾病和死亡等；只要受造物尚未达致圆满，有物质的善，也有物质的恶。","ref":"《天主教教理》310","lesson":"FT-T1-05"},{"id":"permissio","term":"容许","latin":"permissio mali","def":"天主绝不愿意也不造成罪恶，但为了尊重受造物的自由，祂容许恶发生，并奇妙地从恶中引发出善；恶却并不因此而变成善。","ref":"《天主教教理》311–312","lesson":"FT-T1-05"},{"id":"theologia","term":"神学","latin":"theologia","def":"字面意思是“关于天主的言说”：在信仰的光照下，对天主的启示作有系统的反省，是“信仰寻求理解”。","ref":"《天主教教理》158","lesson":"FT-T1-06"},{"id":"theologia-fundamentalis","term":"基本神学","latin":"theologia fundamentalis","def":"研究启示及其可信性，以及信德的行为的神学学科；它“应该说出信德的理由”，并说明信德与哲学思维的关系。","ref":"《信仰与理性》67","lesson":"FT-T1-06"},{"id":"revelatio","term":"启示","latin":"revelatio","def":"天主借着完全自由的决定，把自己启示并赏赐给人，透露祂的奥秘和祂自太初就在基督内预定的慈爱计划。","ref":"《天主教教理》50","lesson":"FT-T1-06"},{"id":"fides-quaerens","term":"信仰寻求理解","latin":"fides quaerens intellectum","def":"圣安瑟莫的话。信仰的内在特色就是信者希望进一步认识他所信的那一位，并进一步理解祂所启示的事。","ref":"《天主教教理》158","lesson":"FT-T1-06"},{"id":"apocrypha","term":"伪经","latin":"apocrypha","def":"古代以圣经人物为题材、但教会不承认为圣经的作品；可能保存一些古老传统，也夹杂许多传说。","ref":"","lesson":"MA-T1-01"},{"id":"filia-sion","term":"熙雍女儿","latin":"filia Sion","def":"旧约对天主子民的称呼；教会以此称玛利亚，她代表那些期待并承受天主救恩的人。","ref":"","lesson":"MA-T1-01","aliases":["熙雍女子"]},{"id":"virginitas","term":"童贞","latin":"virginitas","def":"玛利亚在耶稣受孕、诞生之前、之时和之后，都保持完整的童贞（卒世童贞）。","ref":"","lesson":"MA-T1-02","aliases":["卒世童贞","终身童贞"]},{"id":"praesentatio-bmv","term":"圣母献堂","latin":"Praesentatio B. M. V.","def":"十一月二十一日的纪念日：默观玛利亚从少年时就把自己完全献给天主。","ref":"","lesson":"MA-T1-02"},{"id":"gratia-plena","term":"充满恩宠","latin":"gratia plena","def":"天使对玛利亚的请安（路1:28）：她从天主那里领受了一切相称于天主之母职位的恩赐。","ref":"","lesson":"MA-T1-03","aliases":["满被圣宠","满渥圣宠"]},{"id":"oboeditio-fidei","term":"信德的服从","latin":"oboeditio fidei","def":"人以理智和意志完全顺服启示自己的天主；玛利亚是最完美的典范（罗1:5；《天主教教理》494）。","ref":"","lesson":"MA-T1-03"},{"id":"fiat","term":"尔旨承行","latin":"Fiat","def":"玛利亚的回答：“愿照你的话成就于我罢！”（路1:38）；也是每一个基督徒祈祷的态度。","ref":"","lesson":"MA-T1-03"},{"id":"theologia-spiritualis","term":"灵修神学","latin":"theologia spiritualis","def":"神学的一部分：以启示为根据，研究超性生命的本质、成长和成全，以及达到成全的途径。","ref":"","lesson":"ST-T1-01"},{"id":"ascesis","term":"修德","latin":"ascesis","def":"信徒在恩宠中的合作：祈祷、克己、修德；一切都依靠恩宠。","ref":"","lesson":"ST-T1-01","aliases":["修德学"]},{"id":"mysticus","term":"神秘的","latin":"mysticus","def":"广义：恩宠所赐、日益深入的与基督和圣三的结合（《天主教教理》2014）；狭义：天主在灵魂内的行动，人的努力不能制造。","ref":"","lesson":"ST-T1-01","aliases":["奥秘的","神秘生活"]},{"id":"gloria-dei","term":"天主的光荣","latin":"gloria Dei","def":"天主的美善在受造物中的显示和通传；世界为此而受造（《天主教教理》293–294）。","ref":"","lesson":"ST-T1-02","aliases":["天主的外在光荣"]},{"id":"sanctificatio","term":"成圣","latin":"sanctificatio","def":"圣洗所赐的恩宠生命不断成长，使人越来越肖似基督，直到完全属于天主。","ref":"","lesson":"ST-T1-03"},{"id":"sanctitas","term":"圣德","latin":"sanctitas","def":"与天主结合的生活，其核心是爱德的圆满；众人都蒙召走向圣德（《天主教教理》2013）。","ref":"","lesson":"ST-T1-03"},{"id":"theotokos","term":"天主之母","latin":"Theotokos","def":"玛利亚是天主子按人性的母亲；厄弗所大公会议（431年）宣认她为“天主之母”（《天主教教理》495）。","ref":"","lesson":"MA-T1-04"},{"id":"magnificat","term":"谢主曲","latin":"Magnificat","def":"玛利亚在依撒伯尔家中所唱的赞美诗（路1:46-55），教会每天在晚祷中咏唱。","ref":"","lesson":"MA-T1-04","aliases":["玛利亚之歌","我的灵魂颂扬上主"]},{"id":"iustus","term":"义人","latin":"iustus","def":"在天主前正直的人；福音以此称若瑟（玛1:19）。","ref":"","lesson":"MA-T1-05"},{"id":"sponsa","term":"净配","latin":"sponsa","def":"配偶的尊称；玛利亚是若瑟的净配，若瑟是玛利亚的净配。","ref":"","lesson":"MA-T1-05"},{"id":"cor-conservans","term":"默存在心","latin":"—","def":"玛利亚把天主的作为和话语存在心中反复思想（路2:19,51）：默观的态度。","ref":"","lesson":"MA-T1-06"},{"id":"signum-contradictionis","term":"反对的记号","latin":"signum cui contradicetur","def":"西默盎对耶稣的预言（路2:34）：祂将使人心中的思念显露出来，有人接受祂，有人反对祂。","ref":"","lesson":"MA-T1-07","aliases":["反对的标志"]},{"id":"prophetia-simeonis","term":"西默盎的预言","latin":"—","def":"西默盎在圣殿对玛利亚说：“要有一把利剑刺透妳的心灵”（路2:35），预告十字架的痛苦。","ref":"","lesson":"MA-T1-07"},{"id":"epiphania","term":"主显","latin":"Epiphania","def":"耶稣向万民显示自己；主显节庆祝贤士来朝（《天主教教理》528）。","ref":"","lesson":"MA-T1-08","aliases":["主显节"]},{"id":"vita-abscondita","term":"隐居生活","latin":"vita abscondita","def":"耶稣在纳匝肋约三十年的平凡生活：工作、祈祷、家庭生活、服从父母（《天主教教理》531–534）。","ref":"","lesson":"MA-T1-09"},{"id":"peregrinatio-fidei","term":"信仰的旅程","latin":"peregrinatio fidei","def":"玛利亚在信德中逐步前行，直到十字架下（《教会宪章》58；《救主之母》通谕）。","ref":"","lesson":"MA-T1-09","aliases":["信仰旅途"]},{"id":"intercessio","term":"代祷","latin":"intercessio","def":"为别人向天主祈求；玛利亚在加纳为新人代求（《天主教教理》2618）。","ref":"","lesson":"MA-T1-10","aliases":["转求"]},{"id":"mater-viventium","term":"众生之母","latin":"mater viventium","def":"教父对玛利亚的称呼：新厄娃，在恩宠的秩序中是信徒的母亲（《天主教教理》2618）。","ref":"","lesson":"MA-T1-11","aliases":["生活者的母亲"]},{"id":"assumptio","term":"蒙召升天","latin":"Assumptio","def":"玛利亚在结束了人间生活的过程后，身灵一同被提升到天上的光荣（《教会宪章》59；《天主教教理》966）。","ref":"","lesson":"MA-T1-12","aliases":["圣母升天"]},{"id":"vocatio-universalis","term":"成圣的普遍召叫","latin":"vocatio universalis ad sanctitatem","def":"所有基督徒，不论身分与地位，都蒙召走向基督徒生活的圆满及爱德的完美境界（《教会宪章》第五章；《天主教教理》2013）。","ref":"","lesson":"ST-T1-04","aliases":["普遍的成圣使命"]},{"id":"caritas","term":"爱德","latin":"caritas","def":"超性的德行，借此我们为了天主自身爱祂在万有之上，又为爱天主的缘故爱人如己（《天主教教理》1822）。","ref":"","lesson":"ST-T1-05"},{"id":"perfectio","term":"成全","latin":"perfectio","def":"基督徒生活的圆满；其核心是爱德的成全（《天主教教理》2013）。","ref":"","lesson":"ST-T1-05","aliases":["基督徒的成全"]},{"id":"mysterium-christi","term":"基督的奥迹","latin":"mysterium Christi","def":"基督一生的言行、受苦、死亡和复活；它们启示天父，并在信徒身上延续（《天主教教理》516–521）。","ref":"","lesson":"ST-T1-06","aliases":["基督的奥迹"]},{"id":"configuratio","term":"与基督相似","latin":"configuratio Christo","def":"藉恩宠使自己的思念、言语、行为符合基督的心情，让基督在我们内生活（《天主教教理》1694）。","ref":"","lesson":"ST-T1-07"},{"id":"exemplar-sanctitatis","term":"圣德的模范","latin":"exemplar sanctitatis","def":"教会在玛利亚身上认出圣德的模范和泉源（《天主教教理》2030）。","ref":"","lesson":"ST-T1-08"},{"id":"vita-supernaturalis","term":"超性生命","latin":"vita supernaturalis","def":"天主在圣洗中赐予、超越人本性一切能力的新生命：分享天主自己的生命。","ref":"","lesson":"ST-T2-01","aliases":["恩宠的生命"]},{"id":"consortium","term":"分享天主的性体","latin":"consortium divinae naturae","def":"藉恩宠成为“有分于天主性体的人”（伯后1:4；《天主教教理》1265, 1996）。","ref":"","lesson":"ST-T2-01","aliases":["有分于天主的性体"]},{"id":"gratia-sanctificans","term":"圣化恩宠","latin":"gratia sanctificans","def":"常居的超性恩赐，使人成为天主的子女，能与天主共同生活并以祂的爱而行事（《天主教教理》1999–2000）。","ref":"","lesson":"ST-T2-02","aliases":["神化恩宠","宠爱"]},{"id":"gratia-habitualis","term":"常居的恩宠","latin":"gratia habitualis","def":"恒常的倾向，使人依照天主的召唤而生活和行动；即圣化恩宠（《天主教教理》2000）。","ref":"","lesson":"ST-T2-02"},{"id":"inhabitatio","term":"天主圣三的内居","latin":"inhabitatio Trinitatis","def":"天主圣三以朋友和父亲的方式住在义人的灵魂内（若14:23；《天主教教理》260）。","ref":"","lesson":"ST-T2-03"},{"id":"gratia-actualis","term":"现时的恩宠","latin":"gratia actualis","def":"天主在具体时刻光照理智、推动意志的助佑（《天主教教理》2000）。","ref":"","lesson":"ST-T2-04","aliases":["宠佑","助佑的恩宠"]},{"id":"cooperatio","term":"合作","latin":"cooperatio","def":"人以自由与天主的恩宠合作；天主不愿没有我们而救我们（《天主教教理》2001–2002, 1847）。","ref":"","lesson":"ST-T2-05"},{"id":"meritum","term":"功绩","latin":"meritum","def":"天主自由地安排人与祂恩宠合作，使在恩宠中出于爱德的善行配得恩宠的增长和永生；功绩首先归于天主的恩宠（《天主教教理》2006–2011）。","ref":"","lesson":"ST-T2-06"}]