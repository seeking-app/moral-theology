[{"id":"finis","term":"目的","latin":"finis","def":"我們為了它而行動的那個東西：在實現上最後達到，在意向中卻最先出現。","ref":"神學大全 I-II, q.1","lesson":"T1-01"},{"id":"finis-ultimus","term":"最終目的","latin":"finis ultimus","def":"不再為了其他目的而追求的目的；人的最終目的是天主本身。","ref":"《天主教教理》27","lesson":"T1-06"},{"id":"intentio","term":"意向","latin":"intentio","def":"意志朝向目的的動向；它可以使個別行為，甚至整個生命，指向最終目的。","ref":"《天主教教理》1752","lesson":"T1-01"},{"id":"actus-humanus","term":"人性行為","latin":"actus humanus","def":"出於人經過考慮的自由意志的行為；只有這樣的行為才有倫理上的善惡。","ref":"《天主教教理》1749","lesson":"T1-01"},{"id":"bonum-apparens","term":"表面的善","latin":"bonum apparens","def":"看似對人有益、其實不能成全人的東西；罪人就是被這樣的善欺騙，在錯誤的地方尋找幸福。","ref":"神學大全 I-II, q.8, a.1","lesson":"T1-06"},{"id":"felicitas","term":"幸福","latin":"felicitas","def":"人心安享所渴望之善的狀態。人必然渴望幸福，自由選擇的是在哪裡尋找它。","ref":"《天主教教理》1718","lesson":"T1-06"},{"id":"beatitudo","term":"真福","latin":"beatitudo","def":"人圓滿的幸福，只在於擁有天主；它超越人的能力，是天主白白的恩賜。","ref":"《天主教教理》1722","lesson":"T1-06"},{"id":"supernaturalis","term":"本性的／超性的","aliases":["超性的","超性"],"latin":"naturalis / supernaturalis","def":"本性的，指人憑自己本性的力量所能達到的；超性的，指超越人的一切能力、只能藉天主恩寵達到的。","ref":"《天主教教理》1722","lesson":"T1-06"},{"id":"beatitudo-obiectiva","term":"客觀幸福／主觀幸福","latin":"beatitudo obiectiva / formalis","def":"客觀的幸福是使人幸福的對象本身，即天主；主觀的幸福是人擁有並享受這對象的狀態。","ref":"神學大全 I-II, q.3, a.1","lesson":"T1-06"},{"id":"visio-beatifica","term":"榮福直觀","latin":"visio beatifica","def":"在天上面對面直接看見天主；這是人圓滿的真福。","ref":"《天主教教理》1028","lesson":"T1-11"},{"id":"vita-aeterna","term":"永生","latin":"vita aeterna","def":"分享天主自己的生命；在死後才圓滿達到，但藉信德今天已經開始。","ref":"《真理的光輝》12","lesson":"T1-12"},{"id":"praecepta","term":"誡命","latin":"praecepta","def":"天主指示人生命道路的命令；它們保護人的善，是愛近人的基本條件，也是走向自由的第一步。","ref":"《真理的光輝》12–13","lesson":"T1-12"},{"id":"sequela-christi","term":"跟隨基督","latin":"sequela Christi","def":"基督徒倫理生活的核心：不只是遵守規則，而是親自追隨耶穌，與祂結合。","ref":"《真理的光輝》19","lesson":"T1-12"},{"id":"principium","term":"原則與基礎","latin":"Principium et Fundamentum","def":"聖依納爵《神操》的開端：人受造是為讚美、尊敬和事奉天主，並藉此救自己的靈魂；其他事物都應以能否幫助人達到這目的為準來使用。","ref":"《神操》23","lesson":"T1-12"},{"id":"bonum-commune","term":"公益","latin":"bonum commune","def":"使團體及其成員更容易達到自身成全的社會條件的總和。","ref":"《天主教教理》1906","lesson":"T1-05"},{"id":"religiosus","term":"宗教性的存有","latin":"homo religiosus","def":"人在歷史中以祈禱、祭獻、敬禮、默想等方式表達對天主的尋求；這些表達方式雖然有些是模糊的，卻如此普遍，以致人可以被稱為宗教性的存有。","ref":"《天主教教理》28","lesson":"FT-T1-01"},{"id":"desiderium-dei","term":"對天主的渴望","latin":"desiderium Dei","def":"對天主的渴求已銘刻在人的心中，因為人是由天主及為天主而受造；只有在天主內，人才能找到他不斷尋找的真理和幸福。","ref":"《天主教教理》27","lesson":"FT-T1-01","aliases":["對天主的渴求"]},{"id":"cor-inquietum","term":"不安的心","latin":"cor inquietum","def":"聖奧思定的名言：人是為了天主而受造，除非安息在天主內，人的心得不到安寧。","ref":"《天主教教理》30","lesson":"FT-T1-02"},{"id":"lumen-naturale","term":"理智的自然之光","latin":"lumen naturale rationis","def":"人的理智本身的認識能力。教會教導：人憑理智的自然之光，能透過受造物確實認識天主──萬物的起源和終結。","ref":"《天主教教理》36；《天主之子》2","lesson":"FT-T1-03","aliases":["自然之光"]},{"id":"viae","term":"認識天主的途徑","latin":"viae","def":"從物質世界和人出發、「會集在一起而又令人信服」的論據，能使人確實認識天主存在；它們不是自然科學所尋求的那種證明。","ref":"《天主教教理》31–34","lesson":"FT-T1-03","aliases":["天主存在的証據","天主存在的證據"]},{"id":"contingentia","term":"非必然性","latin":"contingentia","def":"事物存在，卻不是必然存在；它的存在有賴於別的原因。這是從世界出發認識天主的起點之一。","ref":"《天主教教理》32","lesson":"FT-T1-03"},{"id":"necessitas-moralis","term":"啟示在倫理上的必要性","latin":"necessitas moralis revelationis","def":"即使是本來並非不可理解的宗教和倫理真理，人也需要天主啟示的光照，使眾人能毫無困難地、以堅定的確實性並絕無錯誤地認識它們。","ref":"《天主教教理》38","lesson":"FT-T1-04"},{"id":"mysterium","term":"奧蹟","latin":"mysterium","def":"超越人的理智、唯有天主啟示才能認識的真理，例如天主是父、子、聖神。","ref":"《天主教教理》50；237","lesson":"FT-T1-04","aliases":["奧跡","超性真理"]},{"id":"analogia","term":"類比","latin":"analogia","def":"以取自受造物的言語真實地談論天主，同時記得：「每當我們在造物主與受造物之間察覺到若干相同之處時，就必發現兩者間有更大的不同之處」。","ref":"《天主教教理》40–43","lesson":"FT-T1-04"},{"id":"malum-morale","term":"倫理的惡","latin":"malum morale","def":"理性和自由的受造物以自由抉擇所犯的罪；其嚴重性與物質的惡不能相比。天主無論直接或間接，都絕不是倫理惡的原因。","ref":"《天主教教理》311","lesson":"FT-T1-05","aliases":["倫理惡"]},{"id":"malum-physicum","term":"物質的惡","latin":"malum physicum","def":"在一個「在過程中」、邁向最終完美的世界裡，自然界的敗壞、疾病和死亡等；只要受造物尚未達致圓滿，有物質的善，也有物質的惡。","ref":"《天主教教理》310","lesson":"FT-T1-05"},{"id":"permissio","term":"容許","latin":"permissio mali","def":"天主絕不願意也不造成罪惡，但為了尊重受造物的自由，祂容許惡發生，並奇妙地從惡中引發出善；惡卻並不因此而變成善。","ref":"《天主教教理》311–312","lesson":"FT-T1-05"},{"id":"theologia","term":"神學","latin":"theologia","def":"字面意思是「關於天主的言說」：在信仰的光照下，對天主的啟示作有系統的反省，是「信仰尋求理解」。","ref":"《天主教教理》158","lesson":"FT-T1-06"},{"id":"theologia-fundamentalis","term":"基本神學","latin":"theologia fundamentalis","def":"研究啟示及其可信性，以及信德的行為的神學學科；它「應該說出信德的理由」，並說明信德與哲學思維的關係。","ref":"《信仰與理性》67","lesson":"FT-T1-06"},{"id":"revelatio","term":"啟示","latin":"revelatio","def":"天主藉著完全自由的決定，把自己啟示並賞賜給人，透露祂的奧秘和祂自太初就在基督內預定的慈愛計畫。","ref":"《天主教教理》50","lesson":"FT-T1-06"},{"id":"fides-quaerens","term":"信仰尋求理解","latin":"fides quaerens intellectum","def":"聖安瑟莫的話。信仰的內在特色就是信者希望進一步認識他所信的那一位，並進一步理解祂所啟示的事。","ref":"《天主教教理》158","lesson":"FT-T1-06"},{"id":"apocrypha","term":"偽經","latin":"apocrypha","def":"古代以聖經人物為題材、但教會不承認為聖經的作品；可能保存一些古老傳統，也夾雜許多傳說。","ref":"","lesson":"MA-T1-01"},{"id":"filia-sion","term":"熙雍女兒","latin":"filia Sion","def":"舊約對天主子民的稱呼；教會以此稱瑪利亞，她代表那些期待並承受天主救恩的人。","ref":"","lesson":"MA-T1-01","aliases":["熙雍女子"]},{"id":"virginitas","term":"童貞","latin":"virginitas","def":"瑪利亞在耶穌受孕、誕生之前、之時和之後，都保持完整的童貞（卒世童貞）。","ref":"","lesson":"MA-T1-02","aliases":["卒世童貞","終身童貞"]},{"id":"praesentatio-bmv","term":"聖母獻堂","latin":"Praesentatio B. M. V.","def":"十一月二十一日的紀念日：默觀瑪利亞從少年時就把自己完全獻給天主。","ref":"","lesson":"MA-T1-02"},{"id":"gratia-plena","term":"充滿恩寵","latin":"gratia plena","def":"天使對瑪利亞的請安（路1:28）：她從天主那裡領受了一切相稱於天主之母職位的恩賜。","ref":"","lesson":"MA-T1-03","aliases":["滿被聖寵","滿渥聖寵"]},{"id":"oboeditio-fidei","term":"信德的服從","latin":"oboeditio fidei","def":"人以理智和意志完全順服啟示自己的天主；瑪利亞是最完美的典範（羅1:5；《天主教教理》494）。","ref":"","lesson":"MA-T1-03"},{"id":"fiat","term":"爾旨承行","latin":"Fiat","def":"瑪利亞的回答：「願照你的話成就於我罷！」（路1:38）；也是每一個基督徒祈禱的態度。","ref":"","lesson":"MA-T1-03"},{"id":"theologia-spiritualis","term":"靈修神學","latin":"theologia spiritualis","def":"神學的一部分：以啟示為根據，研究超性生命的本質、成長和成全，以及達到成全的途徑。","ref":"","lesson":"ST-T1-01"},{"id":"ascesis","term":"修德","latin":"ascesis","def":"信徒在恩寵中的合作：祈禱、克己、修德；一切都依靠恩寵。","ref":"","lesson":"ST-T1-01","aliases":["修德學"]},{"id":"mysticus","term":"神秘的","latin":"mysticus","def":"廣義：恩寵所賜、日益深入的與基督和聖三的結合（《天主教教理》2014）；狹義：天主在靈魂內的行動，人的努力不能製造。","ref":"","lesson":"ST-T1-01","aliases":["奧秘的","神秘生活"]},{"id":"gloria-dei","term":"天主的光榮","latin":"gloria Dei","def":"天主的美善在受造物中的顯示和通傳；世界為此而受造（《天主教教理》293–294）。","ref":"","lesson":"ST-T1-02","aliases":["天主的外在光榮"]},{"id":"sanctificatio","term":"成聖","latin":"sanctificatio","def":"聖洗所賜的恩寵生命不斷成長，使人越來越肖似基督，直到完全屬於天主。","ref":"","lesson":"ST-T1-03"},{"id":"sanctitas","term":"聖德","latin":"sanctitas","def":"與天主結合的生活，其核心是愛德的圓滿；眾人都蒙召走向聖德（《天主教教理》2013）。","ref":"","lesson":"ST-T1-03"},{"id":"theotokos","term":"天主之母","latin":"Theotokos","def":"瑪利亞是天主子按人性的母親；厄弗所大公會議（431年）宣認她為「天主之母」（《天主教教理》495）。","ref":"","lesson":"MA-T1-04"},{"id":"magnificat","term":"謝主曲","latin":"Magnificat","def":"瑪利亞在依撒伯爾家中所唱的讚美詩（路1:46-55），教會每天在晚禱中詠唱。","ref":"","lesson":"MA-T1-04","aliases":["瑪利亞之歌","我的靈魂頌揚上主"]},{"id":"iustus","term":"義人","latin":"iustus","def":"在天主前正直的人；福音以此稱若瑟（瑪1:19）。","ref":"","lesson":"MA-T1-05"},{"id":"sponsa","term":"淨配","latin":"sponsa","def":"配偶的尊稱；瑪利亞是若瑟的淨配，若瑟是瑪利亞的淨配。","ref":"","lesson":"MA-T1-05"},{"id":"cor-conservans","term":"默存在心","latin":"—","def":"瑪利亞把天主的作為和話語存在心中反覆思想（路2:19,51）：默觀的態度。","ref":"","lesson":"MA-T1-06"},{"id":"signum-contradictionis","term":"反對的記號","latin":"signum cui contradicetur","def":"西默盎對耶穌的預言（路2:34）：祂將使人心中的思念顯露出來，有人接受祂，有人反對祂。","ref":"","lesson":"MA-T1-07","aliases":["反對的標誌"]},{"id":"prophetia-simeonis","term":"西默盎的預言","latin":"—","def":"西默盎在聖殿對瑪利亞說：「要有一把利劍刺透妳的心靈」（路2:35），預告十字架的痛苦。","ref":"","lesson":"MA-T1-07"},{"id":"epiphania","term":"主顯","latin":"Epiphania","def":"耶穌向萬民顯示自己；主顯節慶祝賢士來朝（《天主教教理》528）。","ref":"","lesson":"MA-T1-08","aliases":["主顯節"]},{"id":"vita-abscondita","term":"隱居生活","latin":"vita abscondita","def":"耶穌在納匝肋約三十年的平凡生活：工作、祈禱、家庭生活、服從父母（《天主教教理》531–534）。","ref":"","lesson":"MA-T1-09"},{"id":"peregrinatio-fidei","term":"信仰的旅程","latin":"peregrinatio fidei","def":"瑪利亞在信德中逐步前行，直到十字架下（《教會憲章》58；《救主之母》通諭）。","ref":"","lesson":"MA-T1-09","aliases":["信仰旅途"]},{"id":"intercessio","term":"代禱","latin":"intercessio","def":"為別人向天主祈求；瑪利亞在加納為新人代求（《天主教教理》2618）。","ref":"","lesson":"MA-T1-10","aliases":["轉求"]},{"id":"mater-viventium","term":"眾生之母","latin":"mater viventium","def":"教父對瑪利亞的稱呼：新厄娃，在恩寵的秩序中是信徒的母親（《天主教教理》2618）。","ref":"","lesson":"MA-T1-11","aliases":["生活者的母親"]},{"id":"assumptio","term":"蒙召升天","latin":"Assumptio","def":"瑪利亞在結束了人間生活的過程後，身靈一同被提升到天上的光榮（《教會憲章》59；《天主教教理》966）。","ref":"","lesson":"MA-T1-12","aliases":["聖母升天"]},{"id":"vocatio-universalis","term":"成聖的普遍召叫","latin":"vocatio universalis ad sanctitatem","def":"所有基督徒，不論身分與地位，都蒙召走向基督徒生活的圓滿及愛德的完美境界（《教會憲章》第五章；《天主教教理》2013）。","ref":"","lesson":"ST-T1-04","aliases":["普遍的成聖使命"]},{"id":"caritas","term":"愛德","latin":"caritas","def":"超性的德行，藉此我們為了天主自身愛祂在萬有之上，又為愛天主的緣故愛人如己（《天主教教理》1822）。","ref":"","lesson":"ST-T1-05"},{"id":"perfectio","term":"成全","latin":"perfectio","def":"基督徒生活的圓滿；其核心是愛德的成全（《天主教教理》2013）。","ref":"","lesson":"ST-T1-05","aliases":["基督徒的成全"]},{"id":"mysterium-christi","term":"基督的奧蹟","latin":"mysterium Christi","def":"基督一生的言行、受苦、死亡和復活；它們啟示天父，並在信徒身上延續（《天主教教理》516–521）。","ref":"","lesson":"ST-T1-06","aliases":["基督的奧跡"]},{"id":"configuratio","term":"與基督相似","latin":"configuratio Christo","def":"藉恩寵使自己的思念、言語、行為符合基督的心情，讓基督在我們內生活（《天主教教理》1694）。","ref":"","lesson":"ST-T1-07"},{"id":"exemplar-sanctitatis","term":"聖德的模範","latin":"exemplar sanctitatis","def":"教會在瑪利亞身上認出聖德的模範和泉源（《天主教教理》2030）。","ref":"","lesson":"ST-T1-08"},{"id":"vita-supernaturalis","term":"超性生命","latin":"vita supernaturalis","def":"天主在聖洗中賜予、超越人本性一切能力的新生命：分享天主自己的生命。","ref":"","lesson":"ST-T2-01","aliases":["恩寵的生命"]},{"id":"consortium","term":"分享天主的性體","latin":"consortium divinae naturae","def":"藉恩寵成為「有分於天主性體的人」（伯後1:4；《天主教教理》1265, 1996）。","ref":"","lesson":"ST-T2-01","aliases":["有分於天主的性體"]},{"id":"gratia-sanctificans","term":"聖化恩寵","latin":"gratia sanctificans","def":"常居的超性恩賜，使人成為天主的子女，能與天主共同生活並以祂的愛而行事（《天主教教理》1999–2000）。","ref":"","lesson":"ST-T2-02","aliases":["神化恩寵","寵愛"]},{"id":"gratia-habitualis","term":"常居的恩寵","latin":"gratia habitualis","def":"恆常的傾向，使人依照天主的召喚而生活和行動；即聖化恩寵（《天主教教理》2000）。","ref":"","lesson":"ST-T2-02"},{"id":"inhabitatio","term":"天主聖三的內居","latin":"inhabitatio Trinitatis","def":"天主聖三以朋友和父親的方式住在義人的靈魂內（若14:23；《天主教教理》260）。","ref":"","lesson":"ST-T2-03"},{"id":"gratia-actualis","term":"現時的恩寵","latin":"gratia actualis","def":"天主在具體時刻光照理智、推動意志的助佑（《天主教教理》2000）。","ref":"","lesson":"ST-T2-04","aliases":["寵佑","助佑的恩寵"]},{"id":"cooperatio","term":"合作","latin":"cooperatio","def":"人以自由與天主的恩寵合作；天主不願沒有我們而救我們（《天主教教理》2001–2002, 1847）。","ref":"","lesson":"ST-T2-05"},{"id":"meritum","term":"功績","latin":"meritum","def":"天主自由地安排人與祂恩寵合作，使在恩寵中出於愛德的善行配得恩寵的增長和永生；功績首先歸於天主的恩寵（《天主教教理》2006–2011）。","ref":"","lesson":"ST-T2-06"}]